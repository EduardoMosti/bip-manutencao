<?xml version="1.0" encoding="utf-8"?>
<!--
    Textos da US-01 (máquinas) e da tela de QR.
    Arquivo SEPARADO do strings.xml de propósito: o Android junta todos os XML
    de values/ na compilação, e cada integrante editando o seu arquivo evita
    conflito de merge no Git.
-->
<resources>
    <!-- Títulos das telas (usados no android:label do Manifest) -->
    <string name="titulo_maquinas">Máquinas</string>
    <string name="titulo_cadastro_maquina">Nova máquina</string>
    <string name="titulo_qr">QR Code</string>

    <!-- Lista -->
    <string name="maquina_nova">Cadastrar nova máquina</string>
    <string name="maquina_setor_formato">Setor: %1$s</string>
    <string name="maquinas_vazio_titulo">Nenhuma máquina cadastrada</string>
    <string name="maquinas_vazio_texto">Toque em + para cadastrar a primeira máquina e gerar o QR dela.</string>
    <string name="maquinas_erro">Não foi possível carregar as máquinas. Verifique a internet e se você entrou como técnico.</string>

