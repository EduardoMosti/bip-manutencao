<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bip_grafite"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/bip_grafite"
        app:title="@string/main_titulo"
        app:titleTextColor="@color/bip_texto_primario" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/bip_borda" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/bip_superficie"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/bip_borda"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/main_logado_como"
                    android:textColor="@color/bip_texto_secundario"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/bip_texto_primario"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- US-08: perfil lido de usuarios/{uid} -->
                <TextView
                    android:id="@+id/tvPerfil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/bip_texto_secundario"
                    android:textSize="14sp"
                    android:visibility="gone"
                    tools:text="Perfil: Técnico de manutenção" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- US-08: aviso quando o perfil não existe ou não carregou -->
        <TextView
            android:id="@+id/tvAvisoPerfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textColor="@color/bip_texto_secundario"
            android:textSize="15sp"
            android:visibility="gone" />

        <!-- US-02: ação principal do operador -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAbrirChamado"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="24dp"
            android:text="@string/main_abrir_chamado"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="16dp" />

        <!-- US-12: o operador assina o encerramento com o QR da matrícula -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAssinarEncerramento"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="12dp"
            android:text="@string/main_assinar_encerramento"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            app:strokeColor="@color/bip_borda" />

        <!-- US-03: fila de chamados do técnico -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFilaChamados"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="12dp"
            android:text="@string/main_fila_chamados"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            app:strokeColor="@color/bip_borda" />

        <!-- US-05: chamados assumidos pelo técnico, para encerrar com a solução -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMeusAtendimentos"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="12dp"
            android:text="@string/main_meus_atendimentos"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            app:strokeColor="@color/bip_borda" />

        <!-- US-01: o técnico chega ao cadastro de máquinas e aos QR por aqui -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMaquinas"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="12dp"
            android:text="@string/main_maquinas"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            app:strokeColor="@color/bip_borda" />
    </LinearLayout>
</LinearLayout>