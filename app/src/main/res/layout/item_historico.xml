<?xml version="1.0" encoding="utf-8"?>
<!-- US-06: uma linha do histórico da máquina (situação, descrição, solução, datas e duração). -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/bip_superficie"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/bip_borda"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Selo da situação: texto e cor definidos no Adapter -->
        <com.google.android.material.chip.Chip
            android:id="@+id/chipStatusHistorico"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:focusable="false"
            android:textColor="@color/bip_grafite"
            android:textSize="12sp"
            android:textStyle="bold"
            app:chipMinHeight="28dp"
            app:chipStrokeWidth="0dp"
            app:ensureMinTouchTargetSize="false"
            tools:text="Encerrado" />

        <TextView
            android:id="@+id/tvDescricaoHistorico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/bip_texto_primario"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Vazamento de óleo no cilindro hidráulico" />

        <TextView
            android:id="@+id/tvSolucaoHistorico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/bip_texto_primario"
            android:textSize="14sp"
            tools:text="Solução: troca da vedação do cilindro" />

        <TextView
            android:id="@+id/tvTecnicoHistorico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/bip_texto_secundario"
            android:textSize="13sp"
            tools:text="Técnico: Carlos" />

        <TextView
            android:id="@+id/tvAbertoHistorico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/bip_texto_secundario"
            android:textSize="13sp"
            tools:text="Aberto em 25/11 08:42 por Maria" />

        <TextView
            android:id="@+id/tvEncerradoHistorico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/bip_texto_secundario"
            android:textSize="13sp"
            tools:text="Encerrado em 25/11 10:07" />

        <!-- Duração em destaque (o que o C6 pede) -->
        <TextView
            android:id="@+id/tvDuracaoHistorico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/bip_amarelo"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Duração do reparo: 1 h 25 min" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
