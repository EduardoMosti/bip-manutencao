<?xml version="1.0" encoding="utf-8"?>
<!-- Uma linha da lista de máquinas: código em destaque, nome e setor. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Ícone de QR à esquerda: indica que tocar mostra o QR -->
        <ImageView
            android:id="@+id/ivIconeQr"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_qr_code"
            app:tint="?attr/colorPrimary"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvCodigoMaquina"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivIconeQr"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="MAQ-001" />

        <TextView
            android:id="@+id/tvNomeMaquina"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            app:layout_constraintTop_toBottomOf="@id/tvCodigoMaquina"
            app:layout_constraintStart_toEndOf="@id/ivIconeQr"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="Injetora 3" />

        <TextView
            android:id="@+id/tvSetorMaquina"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintTop_toBottomOf="@id/tvNomeMaquina"
            app:layout_constraintStart_toEndOf="@id/ivIconeQr"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="Setor: Moldagem" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
