<?xml version="1.0" encoding="utf-8"?>
<!--
    US-06 (C6) - Histórico da máquina.
    Estrutura igual à fila: Toolbar + resumo + FrameLayout (lista / progresso / vazio / erro).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bip_grafite"
    android:orientation="vertical"
    tools:context=".HistoricoMaquinaActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/bip_grafite"
        app:subtitleTextColor="@color/bip_amarelo"
        app:title="@string/historico_titulo"
        app:titleTextColor="@color/bip_texto_primario" />

    <!-- Resumo: quantos chamados a máquina já teve -->
    <TextView
        android:id="@+id/tvTotalHistorico"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingBottom="12dp"
        android:textColor="@color/bip_texto_secundario"
        android:textSize="14sp"
        android:visibility="gone"
        tools:text="Total de chamados: 3"
        tools:visibility="visible" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/bip_borda" />

    <!-- As 4 Views ficam uma em cima da outra; o código mostra só uma por vez -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 1) Lista do histórico -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvHistorico"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="16dp"
            android:visibility="gone"
            tools:listitem="@layout/item_historico" />

        <!-- 2) Carregando -->
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progressoHistorico"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true" />

        <!-- 3) Estado vazio (NC5): nunca tela em branco -->
        <LinearLayout
            android:id="@+id/layoutVazioHistorico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/historico_vazio_titulo"
                android:textColor="@color/bip_texto_primario"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/historico_vazio_texto"
                android:textColor="@color/bip_texto_secundario"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- 4) Erro -->
        <TextView
            android:id="@+id/tvErroHistorico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="32dp"
            android:text="@string/historico_erro"
            android:textColor="@color/bip_erro"
            android:textSize="15sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
