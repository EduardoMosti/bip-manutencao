<?xml version="1.0" encoding="utf-8"?>
<!-- US-12: uma linha de "Assinar encerramento": máquina, descrição, solução, técnico, data e botão. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/bip_superficie"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/bip_borda"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvMaquinaAssinatura"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/bip_texto_primario"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="MAQ-001 - Injetora 3" />

        <TextView
            android:id="@+id/tvDescricaoAssinatura"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/bip_texto_primario"
            android:textSize="15sp"
            tools:text="Vazamento de óleo na prensa" />

        <TextView
            android:id="@+id/tvSolucaoAssinatura"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/bip_texto_primario"
            android:textSize="14sp"
            tools:text="Solução: troca da vedação do cilindro" />

        <TextView
            android:id="@+id/tvInfoAssinatura"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/bip_texto_secundario"
            android:textSize="13sp"
            tools:text="Técnico: Carlos · Encerrado em 25/11 14:10" />

        <!-- US-12: abre o leitor de QR da matrícula -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAssinar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            android:text="@string/assinatura_botao" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
