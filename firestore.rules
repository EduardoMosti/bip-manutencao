rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    function perfilDoUsuario() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfil;
    }

    function ehOperador() {
      return logado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && perfilDoUsuario() == 'operador';
    }

    function ehTecnico() {
      return logado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && perfilDoUsuario() == 'tecnico';
    }

    // Perfis: o usuario le o proprio documento, mas nunca escolhe nem altera o perfil.
    // US-12: a matricula tambem e cadastrada pelo grupo no console (como o perfil),
    // porque e ela que vale como assinatura do operador no encerramento do chamado.
    match /usuarios/{uid} {
      allow read: if logado() && request.auth.uid == uid;
      allow create: if logado() && request.auth.uid == uid
                    && !('perfil' in request.resource.data)
                    && !('matricula' in request.resource.data);
      allow update: if logado() && request.auth.uid == uid
                    && !request.resource.data.diff(resource.data).affectedKeys()
                         .hasAny(['perfil', 'matricula']);
      allow delete: if false;
    }

    // Maquinas: operador e tecnico leem, so o tecnico cadastra.
    // US-01: "update" bloqueado -> um cadastro com codigo repetido vira update
    // e e recusado aqui tambem (o app ja checa com transacao; isto e a 2a barreira).
    match /maquinas/{codigo} {
      allow read: if ehOperador() || ehTecnico();
      allow create: if ehTecnico()
                    && request.resource.data.keys().hasOnly(['nome', 'setor'])
                    && request.resource.data.nome is string
                    && request.resource.data.nome.size() > 0
                    && request.resource.data.setor is string
                    && request.resource.data.setor.size() > 0;
      allow update: if false;
      allow delete: if false;
    }

    // Chamados
    match /chamados/{id} {
      allow read: if ehTecnico()
                  || (ehOperador() && resource.data.abertoPor == request.auth.uid);

      allow create: if ehOperador()
                    && request.resource.data.abertoPor == request.auth.uid
                    && request.resource.data.status == 'aberto'
                    && request.resource.data.prioridade in ['baixa', 'media', 'alta']
                    && request.resource.data.maquinaId is string
                    && request.resource.data.descricao is string
                    && request.resource.data.descricao.size() > 0;

      allow update: if (ehTecnico() && (assumir() || encerrar()))
                    || (ehOperador() && assinar());
      allow delete: if false;

      function assumir() {
        return resource.data.status == 'aberto'
          && request.resource.data.status == 'em_atendimento'
          && request.resource.data.tecnicoUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'tecnicoUid', 'tecnicoNome', 'assumidoEm']);
      }

      function encerrar() {
        return resource.data.status == 'em_atendimento'
          && resource.data.tecnicoUid == request.auth.uid
          && request.resource.data.status == 'encerrado'
          && request.resource.data.solucao is string
          && request.resource.data.solucao.size() > 0
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'solucao', 'fechadoEm']);
      }

      // US-12: so o operador que abriu o chamado assina, uma unica vez, depois do
      // encerramento, e a matricula gravada tem de ser a do proprio cadastro dele.
      function assinar() {
        return resource.data.status == 'encerrado'
          && resource.data.abertoPor == request.auth.uid
          && !('assinadoEm' in resource.data)
          && request.resource.data.assinaturaMatricula is string
          && request.resource.data.assinaturaMatricula
               == get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.matricula
          && request.resource.data.assinadoEm == request.time
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['assinaturaMatricula', 'assinadoEm']);
      }
    }
  }
}
